{
  "name": "@stackscan/mcp-server",
  "version": "0.1.1",
  "description": "MCP server for the StackScan Tech Lookup API - look up the technology stack and the company behind any domain.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "stackscan",
    "technographics",
    "tech-stack",
    "firmographics",
    "claude"
  ],
  "homepage": "https://www.stackscan.com/mcp",
  "bugs": {
    "url": "https://github.com/stackscan/stackscan-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackscan/stackscan-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "stackscan-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}